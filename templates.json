	"DSU Template": {
		"prefix": "dsu",
		"body": [
			"class DSU {",
			"public:",
			"    vector<int> parent;",
			"    vector<int> rank;",
			"",
			"    DSU(int n) {",
			"        parent.resize(n + 1);",
			"        rank.resize(n + 1, 0);",
			"        for (int i = 0; i <= n; i++) {",
			"            parent[i] = i;",
			"        }",
			"    }",
			"",
			"    int findParent(int x) {",
			"        if (parent[x] != x) {",
			"            parent[x] = findParent(parent[x]); // Path compression",
			"        }",
			"        return parent[x];",
			"    }",
			"",
			"    bool unite(int a, int b) {",
			"        int pa = findParent(a);",
			"        int pb = findParent(b);",
			"",
			"        if (pa == pb) return false; // Already in the same set",
			"",
			"        if (rank[pa] < rank[pb]) {",
			"            parent[pa] = pb;",
			"        } else if (rank[pa] > rank[pb]) {",
			"            parent[pb] = pa;",
			"        } else {",
			"            parent[pb] = pa;",
			"            rank[pa]++;",
			"        }",
			"        return true;",
			"    }",
			"};"
		],
		"description": "DSU (Disjoint Set Union) template with path compression and union by rank"
	},
	"Cpp_Dijkstra": {
		"prefix": "dijkstra",
		"body": [
			"vector<long long> djikstra(int src, vector<vector<pair<int,int>>>& graph) {",
			"    priority_queue<pair<long long, int>, vector<pair<long long, int>>, greater<pair<long long, int>>> pq;",
			"    vector<bool> vis(graph.size(), false);",
			"    vector<long long> dist(graph.size(), LLONG_MAX);",
			"    pq.push({0, src});",
			"    dist[src] = 0;",
			"    while (!pq.empty()) {",
			"        auto top = pq.top(); pq.pop();",
			"        auto cost = top.first;",
			"        auto node = top.second;",
			"        if (vis[node]) continue;",
			"        vis[node] = true;",
			"        for (auto it : graph[node]) {",
			"            auto nextNode = it.first, nextCost = it.second;",
			"            if (dist[node] + nextCost < dist[nextNode]) {",
			"                dist[nextNode] = dist[node] + nextCost;",
			"                pq.push({dist[nextNode], nextNode});",
			"            }",
			"        }",
			"    }",
			"    return dist;",
			"}"
		],
		"description": "Dijkstra's Algorithm using priority queue and adjacency list"
	},
	"Segment Tree 2D": {
		"prefix": "segment_tree_2d",
		"body": [
			"class SegmentTree2d {",
			"public:",
			"    int sizex, sizey;",
			"    vvi segmentTree;",
			"",
			"    SegmentTree2d(int n, int m) {",
			"        sizex = n;",
			"        sizey = m;",
			"        segmentTree.assign(4 * sizex, vi(4 * sizey));",
			"    }",
			"",
			"    void build(const vvi &matrix) {",
			"        buildx(0, 0, sizex - 1, matrix);",
			"    }",
			"",
			"    void buildx(int nodex, int lx, int rx, const vvi &matrix) {",
			"        if (lx != rx) {",
			"            int mid = (lx + rx) / 2;",
			"            buildx(2 * nodex + 1, lx, mid, matrix);",
			"            buildx(2 * nodex + 2, mid + 1, rx, matrix);",
			"        }",
			"        buildy(nodex, lx, rx, 0, 0, sizey - 1, matrix);",
			"    }",
			"",
			"    void buildy(int nodex, int lx, int rx, int nodey, int ly, int ry, const vvi &matrix) {",
			"        if (ly == ry) {",
			"            if (lx == rx)",
			"                segmentTree[nodex][nodey] = matrix[lx][ly];",
			"            else",
			"                segmentTree[nodex][nodey] = segmentTree[2 * nodex + 1][nodey] + segmentTree[2 * nodex + 2][nodey];",
			"            return;",
			"        }",
			"",
			"        int my = (ly + ry) / 2;",
			"        buildy(nodex, lx, rx, 2 * nodey + 1, ly, my, matrix);",
			"        buildy(nodex, lx, rx, 2 * nodey + 2, my + 1, ry, matrix);",
			"        segmentTree[nodex][nodey] = segmentTree[nodex][2 * nodey + 1] + segmentTree[nodex][2 * nodey + 2];",
			"    }",
			"",
			"    // tlx ---> tree left bound ",
			"    // trx ---> tree right bound ",
			"    int sumX(int nodeX, int tlx, int trx, int lx, int rx, int ly, int ry) {",
			"        if (lx > rx) return 0;",
			"        if (tlx == lx && trx == rx) return sumY(nodeX, 0, 0, sizey - 1, ly, ry);",
			"",
			"        int tmx = (tlx + trx) / 2;",
			"        // we basically trying to serach for a part where the range we are searching for ",
			"        // get an exact match (tlx == lx && trx == rx)",
			"        int left = sumX(2 * nodeX + 1, tlx, tmx, lx, min(rx, tmx), ly, ry);",
			"        int right = sumX(2 * nodeX + 2, tmx + 1, trx, max(tmx + 1, lx), rx, ly, ry);",
			"        return left + right;",
			"    }",
			"",
			"    int sumY(int nodeX, int nodeY, int tly, int try_, int ly, int ry) {",
			"        if (ly > ry) return 0;",
			"        if (tly == ly && try_ == ry)",
			"            return segmentTree[nodeX][nodeY];",
			"",
			"        int tmy = (tly + try_) / 2;",
			"        int left = sumY(nodeX, 2 * nodeY + 1, tly, tmy, ly, min(ry, tmy));",
			"        int right = sumY(nodeX, 2 * nodeY + 2, tmy + 1, try_, max(ly, tmy + 1), ry);",
			"        return left + right;",
			"    }",
			"};"
		],
		"description": "Segment Tree for 2D range queries"
	},
	"SegmentTreeClass": {
		"prefix": "segmenttree",
		"body": [
			"class SegmentTree {",
			"public:",
			"    vector<int> segmentTree;",
			"",
			"    SegmentTree(int n) {",
			"        segmentTree.resize(4 * n);",
			"    }",
			"",
			"    // node ---> in which we have to store the data",
			"    // start and end --> indices for the arr array",
			"    void build(int node, int start, int end, vector<int> &arr) {",
			"        if (start == end) {",
			"            segmentTree[node] = arr[start];",
			"            return;",
			"        }",
			"        int mid = (end - start) / 2 + start;",
			"        build(2 * node + 1, start, mid, arr);",
			"        build(2 * node + 2, mid + 1, end, arr);",
			"        segmentTree[node] = min(segmentTree[2 * node + 2], segmentTree[2 * node + 1]);",
			"    }",
			"",
			"    void build(vector<int> &arr){",
			"        build(0, 0, (int)arr.size() - 1, arr);",
			"    }",
			"",
			"    // l, r ---> range, a query",
			"    int query(int node, int l, int r, int start, int end) {",
			"        if (l > end || r < start) return INT_MAX;",
			"        if (l <= start && r >= end) return segmentTree[node];",
			"",
			"        int mid = (end - start) / 2 + start;",
			"        int left = query(2 * node + 1, l, r, start, mid);",
			"        int right = query(2 * node + 2, l, r, mid + 1, end);",
			"        return min(left, right);",
			"    }",
			"",
			"    int query(int l, int r, int size){",
			"        return query(0, l, r, 0, size - 1);",
			"    }",
			"",
			"    // Point Update",
			"    void update(int node, int start, int end, int idx, int val) {",
			"        if (start == end) {",
			"            segmentTree[node] = val;",
			"            return;",
			"        }",
			"",
			"        int mid = (start + end) / 2;",
			"        if (idx <= mid)",
			"            update(2 * node + 1, start, mid, idx, val);",
			"        else",
			"            update(2 * node + 2, mid + 1, end, idx, val);",
			"",
			"        segmentTree[node] = min(segmentTree[2 * node + 1], segmentTree[2 * node + 2]);",
			"    }",
			"",
			"    void update(int idx, int val, int size) {",
			"        update(0, 0, size - 1, idx, val);",
			"    }",
			"};"
		],
		"description": "Segment Tree (Range Minimum Query + Point Update)"
	},
	"BIT Class": {
		"prefix": "bitClass",
		"body": [
			"// Class-based Binary Indexed Tree (Fenwick Tree)",
			"class BIT {",
			"private:",
			"    int size;",
			"    vector<int> tree;",
			"",
			"public:",
			"    BIT(int n) {",
			"        size = n + 2; // Safe size buffer",
			"        tree.assign(size, 0);",
			"    }",
			"",
			"    void update(int i, int delta) {",
			"        while (i < size) {",
			"            tree[i] += delta;",
			"            i += i & -i;",
			"        }",
			"    }",
			"",
			"    int query(int i) {",
			"        int res = 0;",
			"        while (i > 0) {",
			"            res += tree[i];",
			"            i -= i & -i;",
			"        }",
			"        return res;",
			"    }",
			"",
			"    int query(int l, int r) {",
			"        return query(r) - query(l - 1);",
			"    }",
			"};"
		],
		"description": "C++ class-based Binary Indexed Tree (Fenwick Tree)"
	},
	"Trie Class": {
		"prefix": "trie",
		"body": [
			"class Trie {",
			"    struct Node {",
			"        bool isEnd = false;",
			"        unordered_map<char, Node*> next;",
			"    };",
			"",
			"    Node* root;",
			"public:",
			"    Trie() {",
			"        root = new Node();",
			"    }",
			"",
			"    void insert(string &s) {",
			"        auto temp = root;",
			"        for (int i = 0; i < s.size(); i++) {",
			"            char c = s[i];",
			"            if (!temp->next.count(c)) {",
			"                temp->next[c] = new Node();",
			"            }",
			"            temp = temp->next[c];",
			"        }",
			"        temp->isEnd = true;",
			"    }",
			"",
			"    bool search(string &s) {",
			"        auto temp = root;",
			"        for (int i = 0; i < s.size(); i++) {",
			"            char c = s[i];",
			"            if (!temp->next.count(c)) return false;",
			"            temp = temp->next[c];",
			"        }",
			"        return temp->isEnd;",
			"    }",
			"",
			"    bool startsWith(string &prefix) {",
			"        auto temp = root;",
			"        for (char c : prefix) {",
			"            if (!temp->next.count(c)) return false;",
			"            temp = temp->next[c];",
			"        }",
			"        return true;",
			"    }",
			"};"
		],
		"description": "Simple Trie (Prefix Tree) implementation in C++"
	},
	"Sqrt Decomposition Class": {
		"prefix": "sqrtclass",
		"body": [
			"class SqrtDecomposition {",
			"private:",
			"    int n;                      // size of array",
			"    int B;                      // block size",
			"    vector<long long> arr;      // original array",
			"    vector<long long> blocks;   // precomputed block sums",
			"",
			"public:",
			"    // Constructor: build decomposition",
			"    SqrtDecomposition(const vector<long long>& input) {",
			"        arr = input;",
			"        n = (int)arr.size();",
			"        B = max(1, (int)ceil(sqrt((double)n)));",
			"        int numBlocks = (n + B - 1) / B;",
			"        blocks.assign(numBlocks, 0);",
			"        for (int i = 0; i < n; i++) blocks[i / B] += arr[i];",
			"    }",
			"",
			"    // Query range sum [l, r]",
			"    long long query(int l, int r) {",
			"        long long res = 0;",
			"        int startBlock = l / B, endBlock = r / B;",
			"        if (startBlock == endBlock) {",
			"            for (int i = l; i <= r; i++) res += arr[i];",
			"            return res;",
			"        }",
			"        int leftEnd = (startBlock + 1) * B - 1;",
			"        for (int i = l; i <= min(r, leftEnd); i++) res += arr[i];",
			"        for (int b = startBlock + 1; b <= endBlock - 1; b++) res += blocks[b];",
			"        int rightStart = endBlock * B;",
			"        for (int i = rightStart; i <= r; i++) res += arr[i];",
			"        return res;",
			"    }",
			"",
			"    // Point update: set arr[idx] = val",
			"    void update(int idx, long long val) {",
			"        int blockIndex = idx / B;",
			"        blocks[blockIndex] += (val - arr[idx]);",
			"        arr[idx] = val;",
			"    }",
			"};"
		],
		"description": "Reusable Sqrt Decomposition class"
	},
	"Kosaraju Template": {
		"prefix": "kosaraju", // type this shortcut to expand
		"body": [
			"class Kosaraju {",
			"    int n;",
			"    vector<vector<int>> g, rg; // graph & reversed graph",
			"    vector<int> order, comp, vis;",
			"",
			"    void dfs1(int u) {",
			"        vis[u] = 1;",
			"        for (int v : g[u])",
			"            if (!vis[v]) dfs1(v);",
			"        order.push_back(u);",
			"    }",
			"",
			"    void dfs2(int u, int cid) {",
			"        comp[u] = cid;",
			"        for (int v : rg[u])",
			"            if (comp[v] == -1) dfs2(v, cid);",
			"    }",
			"",
			"public:",
			"    Kosaraju(int n) : n(n) {",
			"        g.assign(n+1, {});",
			"        rg.assign(n+1, {});",
			"        comp.assign(n+1, -1);",
			"        vis.assign(n+1, 0);",
			"    }",
			"",
			"    void addEdge(int u, int v) {",
			"        g[u].push_back(v);",
			"        rg[v].push_back(u); // reverse edge",
			"    }",
			"",
			"    // returns number of components",
			"    int run() {",
			"        for (int i = 1; i <= n; i++)",
			"            if (!vis[i]) dfs1(i);",
			"",
			"        int cid = 0;",
			"        for (int i = n-1; i >= 0; i--) {",
			"            int u = order[i];",
			"            if (comp[u] == -1) dfs2(u, ++cid);",
			"        }",
			"        return cid;",
			"    }",
			"",
			"    vector<int> getComponents() {",
			"        return comp;",
			"    }",
			"};"
		],
		"description": "Kosaraju's Algorithm Template (class-based)"
	},
	"Topological Sort BFS": {
		"prefix": "toposort",
		"body": [
			"vector<int> topoSortBFS(int n, vector<vector<int>>& adj) {",
			"    vector<int> indegree(n, 0);",
			"    for (int i = 0; i < n; i++) {",
			"        for (int v : adj[i]) indegree[v]++;",
			"    }",
			"",
			"    queue<int> q;",
			"    for (int i = 0; i < n; i++) {",
			"        if (indegree[i] == 0) q.push(i);",
			"    }",
			"",
			"    vector<int> topo;",
			"    while (!q.empty()) {",
			"        int u = q.front(); q.pop();",
			"        topo.push_back(u);",
			"",
			"        for (int v : adj[u]) {",
			"            if (--indegree[v] == 0) q.push(v);",
			"        }",
			"    }",
			"",
			"    return topo; // if size < n => cycle exists",
			"}"
		],
		"description": "Topological Sort using BFS (Kahn’s Algorithm)"
	},
	"KMP Template": {
		"prefix": "kmp",
		"body": [
			"vi generateLps(string &pat) {",
			"    int n = pat.size();",
			"    vi lps(n, 0);",
			"    int len = 0, i = 1;",
			"",
			"    while (i < n) {",
			"        if (pat[i] == pat[len]) {",
			"            lps[i++] = ++len;",
			"        } else {",
			"            if (len != 0) len = lps[len - 1];",
			"            else lps[i++] = 0;",
			"        }",
			"    }",
			"    return lps;",
			"}",
			"",
			"int kmpSearch(string &txt, string &pat) {",
			"    vi lps = generateLps(pat);",
			"    int i = 0, j = 0, cnt = 0;",
			"",
			"    while (i < txt.size()) {",
			"        if (txt[i] == pat[j]) {",
			"            i++; j++;",
			"        }",
			"        if (j == pat.size()) {",
			"            cnt++;",
			"            j = lps[j - 1];",
			"        } else if (i < txt.size() && txt[i] != pat[j]) {",
			"            if (j != 0) j = lps[j - 1];",
			"            else i++;",
			"        }",
			"    }",
			"    return cnt;",
			"}"
		],
		"description": "KMP string matching template"
	},
	"Manacher Template": {
		"prefix": "manacher",
		"body": [
			"string manacher(const string &s) {",
			"    string t = \"^\";",
			"    for (char c : s) {",
			"        t += \"#\";",
			"        t += c;",
			"    }",
			"    t += \"#$\";",
			"",
			"    int n = t.size();",
			"    vector<int> P(n, 0);",
			"    int center = 0, right = 0;",
			"",
			"    for (int i = 1; i < n - 1; i++) {",
			"        int mirror = 2 * center - i;",
			"        if (i < right)",
			"            P[i] = min(right - i, P[mirror]);",
			"",
			"        while (t[i + 1 + P[i]] == t[i - 1 - P[i]])",
			"            P[i]++;",
			"",
			"        if (i + P[i] > right) {",
			"            center = i;",
			"            right = i + P[i];",
			"        }",
			"    }",
			"",
			"    int maxLen = 0, centerIndex = 0;",
			"    for (int i = 1; i < n - 1; i++) {",
			"        if (P[i] > maxLen) {",
			"            maxLen = P[i];",
			"            centerIndex = i;",
			"        }",
			"    }",
			"",
			"    int start = (centerIndex - maxLen) / 2;",
			"    return s.substr(start, maxLen);",
			"}"
		],
		"description": "Manacher's algorithm template for longest palindromic substring"
	},
	"Mo's Algorithm Template": {
		"prefix": "moalgo",
		"body": [
			"class Mo {",
			"public:",
			"    struct Query {",
			"        // l,r --> query range [l,r]",
			"        // idx --> original pos of each query",
			"        int l, r, idx;",
			"        bool operator<(Query &other) {",
			"            int blockA = l / block_size;",
			"            int blockB = other.l / block_size;",
			"            if (blockA != blockB)",
			"                return blockA < blockB;",
			"            // Optimization: alternate sort order by block to reduce movement",
			"            return (blockA & 1) ? (r > other.r) : (r < other.r);",
			"        }",
			"        // This specific sorting order ensures that the left pointer of the sliding window moves slowly, and the right pointer sweeps back and forth, minimizing total pointer movement.",
			"    };",
			"",
			"    static int block_size;",
			"",
			"    int n;",
			"    vector<int> arr;",
			"    vector<Query> queries;",
			"",
			"    // Problem-specific data",
			"    vector<int> freq;",
			"    long long curr_answer = 0; // Change this type based on the problem",
			"",
			"    Mo(vector<int> &a) {",
			"        arr = a;",
			"        n = (int)a.size();",
			"        block_size = max(1, (int)sqrt(n));",
			"        // freq ---> problem specific DS",
			"        freq.assign(1e6 + 5, 0); // Adjust depending on value range",
			"    }",
			"",
			"    void add_query(int l, int r, int idx) {",
			"        queries.push_back({l, r, idx});",
			"    }",
			"",
			"    void add(int idx) {",
			"        int val = arr[idx];",
			"        // Example: distinct count logic",
			"        freq[val]++;",
			"        // it means we encountered that number very first time",
			"        if (freq[val] == 1) curr_answer++;",
			"    }",
			"",
			"    void remove(int idx) {",
			"        int val = arr[idx];",
			"        freq[val]--;",
			"        if (freq[val] == 0) curr_answer--;",
			"    }",
			"",
			"    long long get_answer() const {",
			"        return curr_answer;",
			"    }",
			"",
			"    vector<long long> process() {",
			"        sort(queries.begin(), queries.end());",
			"        vector<long long> answers(queries.size());",
			"        int cur_l = 0, cur_r = -1;",
			"",
			"        for (auto &q : queries) {",
			"            while (cur_l > q.l) add(--cur_l);",
			"            while (cur_r < q.r) add(++cur_r);",
			"            while (cur_l < q.l) remove(cur_l++);",
			"            while (cur_r > q.r) remove(cur_r--);",
			"",
			"            answers[q.idx] = get_answer();",
			"        }",
			"        return answers;",
			"    }",
			"};",
			"",
			"// Definition for static member",
			"int Mo::block_size = 0;"
		],
		"description": "General class-based template for Mo's Algorithm"
	},
	"2D BIT Template": {
		"prefix": "bit2d",
		"body": [
			"class BIT2D {",
			"private:",
			"    int n, m;",
			"    vector<vector<int>> tree;",
			"",
			"public:",
			"    BIT2D(int rows, int cols) {",
			"        n = rows + 2; // Safe buffer",
			"        m = cols + 2;",
			"        tree.assign(n, vector<int>(m, 0));",
			"    }",
			"",
			"    // Point update: adds `delta` to cell (x, y)",
			"    void update(int x, int y, int delta) {",
			"        for (int i = x; i < n; i += i & -i) {",
			"            for (int j = y; j < m; j += j & -j) {",
			"                tree[i][j] += delta;",
			"            }",
			"        }",
			"    }",
			"",
			"    // Query sum from (1,1) to (x,y)",
			"    int query(int x, int y) {",
			"        int res = 0;",
			"        for (int i = x; i > 0; i -= i & -i) {",
			"            for (int j = y; j > 0; j -= j & -j) {",
			"                res += tree[i][j];",
			"            }",
			"        }",
			"        return res;",
			"    }",
			"",
			"    // Query sum in rectangle (x1,y1) to (x2,y2)",
			"    int query(int x1, int y1, int x2, int y2) {",
			"        return query(x2, y2)",
			"             - query(x1 - 1, y2)",
			"             - query(x2, y1 - 1)",
			"             + query(x1 - 1, y1 - 1);",
			"    }",
			"};"
		],
		"description": "2D Binary Indexed Tree (Fenwick Tree) for sum queries"
	},
	"Modular Inverse (Fermat)": {
		"prefix": "getinv",
		"body": [
			"ll getInverse(ll n) {",
			"    ll exp = mod - 2;",
			"    ll res = 1, base = n;",
			"    while (exp > 0) {",
			"        if (exp & 1) res = (res * base) % mod;",
			"        base = (base * base) % mod;",
			"        exp >>= 1;",
			"    }",
			"    return res;",
			"}"
		],
		"description": "Finds modular inverse using Fermat's Little Theorem and fast exponentiation"
